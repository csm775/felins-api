  "item": [
    {
      "name": "Chat",
      "item": [
        {
          "name": "Créer un chat",
          "request": {
            "method": "POST",
            "url": {
              "raw": "http://localhost:8080/chat?couleur=noir&age=3",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["chat"],
              "query": [
                { "key": "couleur", "value": "noir" },
                { "key": "age", "value": "3" }
              ]
            }
          }
        },
        {
          "name": "Récupérer un chat",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/chat/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["chat", "1"]
            }
          }
        },
        {
          "name": "Cri du chat",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/chat/cri",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["chat", "cri"]
            }
          }
        }
      ]
    },
